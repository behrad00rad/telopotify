{
  "name": "telopotify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-isolation=none TelopotifyApp/src/core/*.test.mjs spikes/range-stream/*.test.mjs spikes/telegram-client/*.test.mjs web/*.test.mjs",
    "app:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-windows.ps1",
    "icons:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-windows-icons.ps1",
    "spike:telegram": "node spikes/telegram-client/probe.mjs",
    "dev:library": "node spikes/telegram-client/library-server.mjs",
    "web:gateway": "node web/gateway.mjs",
    "web:accounts": "node web/multiuser.mjs"
  },
  "dependencies": {
    "teleproto": "1.229.0"
  }
}
